+            return@launch
+        }
+        val name = "$muscle Focus"
+        val templateId = workoutRepository.insertTemplate(
+            WorkoutTemplate(name = name, isBuiltIn = false)
+        ).toInt()
+        exercises.forEachIndexed { index, ex ->
+            workoutRepository.insertTemplateExercise(
