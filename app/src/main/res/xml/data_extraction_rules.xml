<?xml version="1.0" encoding="utf-8"?>
<!--
  Sprint 19 privacy fix (Android 12+). cloud-backup: EXCLUDE all app data so the
  workout database / preferences are never uploaded to the user's Google cloud
  (matches the Privacy Policy: data stays on device). device-transfer: still
  INCLUDE, so a direct device-to-device transfer when the user upgrades phones does
  not lose their data - this stays on the user's own hardware, never in the cloud.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
