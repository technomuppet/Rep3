package com.replog.domain.visual.anatomy

import android.content.Context
import com.caverock.androidsvg.SVG
import java.io.FileNotFoundException
import java.io.IOException

/**
 * Loads complete layered SVG documents from app assets.
 *
 * This intentionally does not inspect path IDs or convert SVG geometry into
 * Compose paths. Each file is treated as a complete, aligned document.
 */
class AnatomyAssetLoader(private val context: Context) {

    fun load(asset: AnatomyLayerAsset): SvgLoadResult = load(asset.assetPath)

    fun load(assetPath: String): SvgLoadResult {
        val normalizedPath = assetPath.trim()
        if (normalizedPath.isEmpty()) {
            RendererDiagnostics.missingSvgAsset(assetPath, "Blank asset path")
            return SvgLoadResult.Missing(assetPath = assetPath, reason = "Blank asset path")
        }

        return try {
            context.assets.open(normalizedPath).use { stream ->
                val svg = SVG.getFromInputStream(stream)
                svg.setDocumentViewBox(0f, 0f, 768f, 1536f)
                svg.setDocumentWidth("768px")
                svg.setDocumentHeight("1536px")

                android.util.Log.d("SVG_DEBUG",
                    "asset=" + normalizedPath +
                    " width=" + svg.documentWidth +
                    " height=" + svg.documentHeight +
                    " viewBox=" + svg.documentViewBox)
                SvgLoadResult.Success(assetPath = normalizedPath, svg = svg)
            }
        } catch (e: FileNotFoundException) {
            RendererDiagnostics.missingSvgAsset(normalizedPath, e.message)
            SvgLoadResult.Missing(assetPath = normalizedPath, reason = e.message ?: "Asset not found")
        } catch (e: IOException) {
            RendererDiagnostics.missingSvgAsset(normalizedPath, e.message)
            SvgLoadResult.Missing(assetPath = normalizedPath, reason = e.message ?: "Asset read failed")
        } catch (e: Exception) {
            RendererDiagnostics.malformedSvgAsset(normalizedPath, e.message)
            SvgLoadResult.Malformed(assetPath = normalizedPath, reason = e.message ?: "SVG parse failed")
        }
    }
}

sealed interface SvgLoadResult {
    val assetPath: String

    data class Success(
        override val assetPath: String,
        val svg: SVG
    ) : SvgLoadResult

    data class Missing(
        override val assetPath: String,
        val reason: String
    ) : SvgLoadResult

    data class Malformed(
        override val assetPath: String,
        val reason: String
    ) : SvgLoadResult
}
